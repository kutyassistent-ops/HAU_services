# Пример переменных окружения.
# Приложение НЕ читает .env автоматически: задайте эти переменные
# в оболочке, сервисе systemd/Windows или в конфигурации контейнера.

# Ключ подписи сессий и CSRF-токенов. Обязательно замените.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Путь к файлу SQLite. По умолчанию instance/utility_billing.db
# В Docker используется /data/utility_billing.db (том hau_data).
DATABASE_PATH=instance/utility_billing.db

# Адрес и порт встроенного сервера Flask.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 1 включает режим отладки и автоперезагрузку (только для разработки).
FLASK_DEBUG=0

# Логирование.
LOG_LEVEL=INFO
LOG_FILE=instance/app.log

# --- Безопасность сессии ---
# 1 — передавать cookie только по HTTPS. Включайте на production.
SESSION_COOKIE_SECURE=0
# Срок жизни обычной сессии и cookie «запомнить меня», в днях.
SESSION_DAYS=7
REMEMBER_DAYS=14
# Ограничение неудачных попыток входа (в памяти процесса).
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Email-уведомления (SMTP) ---
# По умолчанию отправка отключена. Включите, задав 1 и параметры SMTP.
NOTIFICATIONS_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.ru
# 1 — использовать STARTTLS.
SMTP_USE_TLS=1
SMTP_TIMEOUT=10

# --- Docker ---
# В docker-compose.yml переменные передаются контейнеру через environment.
# База и логи хранятся в томе hau_data и переживают пересоздание контейнера.
# Пример запуска с собственным ключом:
#   SECRET_KEY="$(python -c 'import secrets; print(secrets.token_hex(32))')" \
#     docker compose up -d --build
